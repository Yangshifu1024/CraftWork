{
  "name": "craftwork",
  "productName": "CraftWork",
  "version": "0.2.0",
  "description": "可审计的桌面 Agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "author": "CraftWork",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --port 5173 --strictPort",
    "build": "tauri build",
    "build:web": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "check:docs": "node scripts/docscheck.mjs",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace --no-fail-fast",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "dist:dir": "tauri build --debug --bundles app",
    "dist": "tauri build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@streamdown/code": "2.0.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
